{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "www.autosleutel-hengelo.nl" }], "destination": "https://autosleutel-hengelo.nl/", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "autosleutel-hengelo.vercel.app" }], "destination": "https://autosleutel-hengelo.nl/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.autosleutel-hengelo.nl" }], "destination": "https://autosleutel-hengelo.nl/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "autosleutel-hengelo.vercel.app" }], "destination": "https://autosleutel-hengelo.nl/:path*", "permanent": true },
    { "source": "/services", "destination": "/prijzen", "permanent": true },
    { "source": "/appointment", "destination": "/contact", "permanent": true },
    { "source": "/about", "destination": "/autosleutel-reparatie", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*).css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*).js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
